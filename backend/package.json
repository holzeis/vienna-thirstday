{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/db/seed-data && cp src/db/seed-data/*.json dist/db/seed-data/ 2>/dev/null || true",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "ts-node --transpile-only src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "seed": "ts-node --transpile-only src/db/seed.ts",
    "seed:sample": "ts-node --transpile-only src/db/seed-sample.ts",
    "seed:import-xlsx": "ts-node --transpile-only src/db/import-xlsx-seed.ts",
    "fixup:mark-unclaimed-guests": "ts-node --transpile-only src/db/mark-unclaimed-as-guests.ts",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.1",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.6.3",
    "vitest": "^5.0.0"
  }
}
